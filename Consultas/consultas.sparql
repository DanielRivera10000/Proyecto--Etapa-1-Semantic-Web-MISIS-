
# CONSULTAS SPARQL - PROYECTO ETAPA 2 (MISIS)


# ------------------------- CONSULTA 1 -------------------------
# ¿Qué canciones están asociadas a un artista determinado, 
# cuáles son los lanzamientos a los que pertenecen y qué información se 
# encuentra disponible sobre su año, duración y género musical?

PREFIX music: <https://github.com/DanielRivera10000/Proyecto--Etapa-1-Semantic-Web-MISIS-/ontology#>

SELECT DISTINCT ?titulo ?nombreArtista ?nombreLanzamiento ?anio ?duracion ?nombreGenero
WHERE {
    ?artista music:mbid_artista "a74b1b7f-71a5-4011-9441-d0b5e4122711" .
    ?artista music:nombre_artista ?nombreArtista .

    ?cancion a music:Cancion .
    ?cancion music:interpretadoPor ?artista .
    ?cancion music:titulo ?titulo .

    OPTIONAL 
    {
        ?cancion music:perteneceALanzamiento ?lanzamiento .
        ?lanzamiento music:nombre ?nombreLanzamiento .
    }

    OPTIONAL { ?cancion music:anio ?anio . }
    OPTIONAL { ?cancion music:duracion ?duracion . }

    OPTIONAL 
    {
        ?cancion music:tieneGeneroPrincipal ?genero .
        ?genero music:nombre ?nombreGenero .
    }
}

ORDER BY ?titulo

# ------------------------- CONSULTA 2 -------------------------
# ¿Qué canciones presentan múltiples clasificaciones de género musical, 
# cuáles son los géneros asociados y qué artistas interpretan dichas canciones?

PREFIX music: <https://github.com/DanielRivera10000/Proyecto--Etapa-1-Semantic-Web-MISIS-/ontology#>

SELECT DISTINCT ?titulo ?nombreArtista ?nombrePrincipal ?nombreMinoritario
WHERE {
    ?cancion a music:Cancion .
    ?cancion music:titulo ?titulo .
    ?cancion music:interpretadoPor ?artista .
    ?cancion music:tieneGeneroPrincipal ?generoPrincipal .
    ?cancion music:tieneGeneroMinoritario ?generoMinoritario .

    ?artista music:nombre_artista ?nombreArtista .
    ?generoPrincipal music:nombre ?nombrePrincipal .
    ?generoMinoritario music:nombre ?nombreMinoritario .

    FILTER(?generoPrincipal != ?generoMinoritario)
}

ORDER BY ?titulo


# ------------------------- CONSULTA 5 -------------------------
# A partir de un artista seleccionado mediante su identificador de MusicBrainz, 
# ¿Qué géneros musicales están asociados a dicho artista?

PREFIX music: <https://github.com/DanielRivera10000/Proyecto--Etapa-1-Semantic-Web-MISIS-/ontology#>

SELECT DISTINCT ?nombreGenero
WHERE {
    ?artista music:mbid_artista "2f9ecbed-27be-40e6-abca-6de49d50299e" .
    ?artista music:tieneGenero ?genero .
    ?genero music:nombre ?nombreGenero .
}
ORDER BY ?nombreGenero


# ------------------------- CONSULTA 6 -------------------------
# ¿Cuáles son los diez artistas con mayor cantidad de canciones 
# registradas dentro de un género musical seleccionado y cuántas canciones tiene cada uno?

PREFIX music: <https://github.com/DanielRivera10000/Proyecto--Etapa-1-Semantic-Web-MISIS-/ontology#>

SELECT (MIN(?nombre) AS ?nombreArtista)
       (COUNT(DISTINCT ?cancion) AS ?cantidadCanciones)
WHERE {
    ?genero music:nombre "Rock" .

    ?cancion a music:Cancion .
    ?cancion music:tieneGeneroPrincipal ?genero .
    ?cancion music:interpretadoPor ?artista .

    ?artista music:nombre_artista ?nombre .
}
GROUP BY ?artista
ORDER BY DESC(?cantidadCanciones) ?nombreArtista
LIMIT 10



# ------------------------- CONSULTA 8 -------------------------
# ¿Cómo se distribuyen las canciones según su género musical y el país o región de sus artistas, 
# y cuántas canciones diferentes corresponden a cada combinación?

PREFIX music: <https://github.com/DanielRivera10000/Proyecto--Etapa-1-Semantic-Web-MISIS-/ontology#>

SELECT ?nombreGenero ?paisRegion (COUNT(DISTINCT ?cancion) AS ?cantidadCanciones)
WHERE {
    ?cancion a music:Cancion .
    ?cancion music:tieneGeneroPrincipal ?genero .
    ?cancion music:interpretadoPor ?artista .

    ?genero music:nombre ?nombreGenero .
    ?artista music:asociadoALugar ?lugar .
    ?lugar music:nombre ?paisRegion .
}

GROUP BY ?nombreGenero ?paisRegion
ORDER BY DESC(?cantidadCanciones) ?nombreGenero ?paisRegion
